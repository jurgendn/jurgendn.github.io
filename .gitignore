# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
.asset-cache/
.jekyll-assets-cache/
assets/css/*.map

# Ruby / Bundler
.bundle/
/vendor/
/lib/bundler/man/
*.gem
*.rbc

# Keep Gemfile.lock and .ruby-version tracked for reproducible builds.

# Node / JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python environments and caches (used by markdown_generator)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
env/
venv/

# Logs, temporary files, and generated reports
*.log
/tmp/
/test/tmp/
/test/version_tmp/
/coverage/
/pkg/
/spec/reports/
/spec/examples.txt

# Local configuration and secrets
.env
.env.*
!.env.example
local/
/ECTS Conversion.xlsx

# OS files
.DS_Store
Thumbs.db

# Editors/IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp

# Byebug and RubyMotion artifacts
.byebug_history
.dat*
.repl_history
build/
*.bridgesupport
build-iPhoneOS/
build-iPhoneSimulator/

# Documentation caches and generated files
/.yardoc/
/_yardoc/
/doc/
/rdoc/

# rvm
.rvmrc
